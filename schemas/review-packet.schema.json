{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tanabe1478/jp-docs-harness/schemas/review-packet.schema.json",
  "title": "jp-docs-harness review packet",
  "type": "object",
  "required": ["schemaVersion", "document", "contract", "rubric", "grounding"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "document": {
      "type": "object",
      "required": ["path", "contentHash", "content"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "content": { "type": "string" }
      },
      "additionalProperties": false
    },
    "contract": {
      "type": "object",
      "required": ["path", "contractHash", "profile", "audience", "readerDelta", "evidence", "nonGoals"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "contractHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "profile": { "type": "string", "minLength": 1 },
        "audience": { "type": "object" },
        "readerDelta": { "type": "object" },
        "evidence": { "type": "object" },
        "nonGoals": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "rubric": {
      "type": "object",
      "required": ["rubricHash", "metaRubrics", "checks", "authorOnly"],
      "properties": {
        "rubricHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "metaRubrics": { "type": "array", "items": { "type": "object" } },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "metaRubricId", "kind", "importance", "criterion", "sourcePolicy", "sourceIds"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "metaRubricId": { "type": "string", "minLength": 1 },
              "kind": { "type": "string", "minLength": 1 },
              "importance": { "enum": ["answer-critical", "valuable", "context"] },
              "criterion": { "type": "string", "minLength": 1 },
              "sourcePolicy": { "enum": ["contract", "available", "required"] },
              "sourceIds": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "additionalProperties": false
          }
        },
        "authorOnly": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "grounding": {
      "type": "object",
      "required": ["evidenceHash", "policy", "sources"],
      "properties": {
        "evidenceHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "policy": { "enum": ["cite-or-flag", "no-declared-sources"] },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "status"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "pattern": "^https?://" },
              "status": { "enum": ["loaded", "missing", "external"] },
              "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
              "content": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
