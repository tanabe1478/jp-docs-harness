{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tanabe1478/jp-docs-harness/schemas/review-result.schema.json",
  "title": "jp-docs-harness semantic review result",
  "type": "object",
  "required": ["schemaVersion", "document", "contract", "rubricHash", "evidenceHash", "judge", "evaluations", "authorEvaluations", "groundingCoverage", "claimEvaluations"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "document": {
      "type": "object",
      "required": ["path", "contentHash"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "contract": {
      "type": "object",
      "required": ["path", "contractHash"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "contractHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "rubricHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "evidenceHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "judge": {
      "type": "object",
      "required": ["provider", "model", "promptVersion"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "promptVersion": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "evaluations": {
      "type": "array",
      "items": { "$ref": "#/$defs/evaluation" }
    },
    "authorEvaluations": {
      "type": "array",
      "items": { "$ref": "#/$defs/authorEvaluation" }
    },
    "groundingCoverage": {
      "type": "object",
      "required": ["status", "justification"],
      "properties": {
        "status": { "enum": ["reviewed", "no_verifiable_claims"] },
        "justification": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "claimEvaluations": {
      "type": "array",
      "items": { "$ref": "#/$defs/claimEvaluation" }
    }
  },
  "$defs": {
    "location": {
      "type": ["object", "null"],
      "properties": {
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 }
      },
      "required": ["startLine", "endLine"],
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "required": ["checkId", "verdict", "resolution", "justification", "location", "claimIds", "repairableByAgent"],
      "properties": {
        "checkId": { "type": "string", "minLength": 1 },
        "verdict": { "enum": ["meets", "partially_meets", "missing", "contradicts"] },
        "resolution": { "enum": ["agent", "needs_author", "uncertain", "none"] },
        "justification": { "type": "string", "minLength": 1 },
        "location": { "$ref": "#/$defs/location" },
        "claimIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^claim-[0-9]{3,}$" }
        },
        "repairableByAgent": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "claimEvidence": {
      "type": "object",
      "required": ["sourceId", "startLine", "endLine"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "claimEvaluation": {
      "type": "object",
      "required": ["claimId", "text", "kind", "verdict", "resolution", "justification", "location", "evidence", "repairableByAgent"],
      "properties": {
        "claimId": { "type": "string", "pattern": "^claim-[0-9]{3,}$" },
        "text": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["factual", "recommendation", "author-experience"] },
        "verdict": { "enum": ["supported", "partially_supported", "unsupported", "conflicts", "not_applicable"] },
        "resolution": { "enum": ["agent", "needs_author", "uncertain", "none"] },
        "justification": { "type": "string", "minLength": 1 },
        "location": { "$ref": "#/$defs/location" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/claimEvidence" } },
        "repairableByAgent": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "verdict": { "enum": ["supported", "partially_supported", "conflicts"] } }, "required": ["verdict"] },
          "then": { "properties": { "evidence": { "minItems": 1 } } }
        }
      ],
      "additionalProperties": false
    },
    "authorEvaluation": {
      "type": "object",
      "required": ["item", "status", "justification", "location"],
      "properties": {
        "item": { "type": "string", "minLength": 1 },
        "status": { "enum": ["provided", "missing", "uncertain"] },
        "justification": { "type": "string", "minLength": 1 },
        "location": { "$ref": "#/$defs/location" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
