{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tanabe1478/jp-docs-harness/schemas/intent.schema.json",
  "title": "jp-docs-harness document contract",
  "type": "object",
  "required": ["version", "profile", "audience", "reader_delta", "requirements"],
  "properties": {
    "version": { "const": 1 },
    "profile": {
      "enum": ["technical-explainer", "tutorial", "decision-proposal", "essay", "reference"]
    },
    "audience": {
      "type": "object",
      "required": ["problem"],
      "properties": {
        "knows": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "problem": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          ]
        }
      },
      "additionalProperties": false
    },
    "reader_delta": {
      "type": "object",
      "required": ["know", "decide", "do"],
      "properties": {
        "know": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "decide": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "do": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "requirements": {
      "oneOf": [
        { "$ref": "#/$defs/shorthandRequirements" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/typedRequirement" }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "pattern": "^https?://" },
              "description": { "type": "string", "minLength": 1 }
            },
            "anyOf": [{ "required": ["path"] }, { "required": ["url"] }],
            "additionalProperties": false
          }
        },
        "author_only": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "non_goals": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "review": {
      "type": "object",
      "properties": {
        "semantic": {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["manual", "contracted", "strict"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "shorthandRequirements": {
      "type": "object",
      "required": ["critical"],
      "properties": {
        "critical": { "$ref": "#/$defs/stringList" },
        "valuable": { "$ref": "#/$defs/stringList" },
        "context": { "$ref": "#/$defs/stringList" }
      },
      "additionalProperties": false
    },
    "typedRequirement": {
      "type": "object",
      "required": ["id", "importance", "type", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "importance": { "enum": ["answer-critical", "valuable", "context"] },
        "type": {
          "enum": ["simple-knowledge", "strict-list", "flexible-list", "process", "relationship"]
        },
        "description": { "type": "string", "minLength": 1 },
        "fact": { "type": "string", "minLength": 1 },
        "items": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "baseline": { "type": "integer", "minimum": 1 },
        "ordered_steps": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["text", "mandatory"],
            "properties": {
              "text": { "type": "string", "minLength": 1 },
              "mandatory": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "entities": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
        "aspects": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "meta_insight": { "type": "string", "minLength": 1 },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "simple-knowledge" } }, "required": ["type"] },
          "then": { "required": ["fact"] }
        },
        {
          "if": { "properties": { "type": { "enum": ["strict-list", "flexible-list"] } }, "required": ["type"] },
          "then": { "required": ["items"] }
        },
        {
          "if": { "properties": { "type": { "const": "flexible-list" } }, "required": ["type"] },
          "then": { "required": ["baseline"] }
        },
        {
          "if": { "properties": { "type": { "const": "process" } }, "required": ["type"] },
          "then": { "required": ["ordered_steps"] }
        },
        {
          "if": { "properties": { "type": { "const": "relationship" } }, "required": ["type"] },
          "then": { "required": ["entities", "aspects"] }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
