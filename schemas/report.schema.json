{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tanabe1478/jp-docs-harness/schemas/report.schema.json",
  "title": "jp-docs-harness report",
  "type": "object",
  "required": ["schemaVersion", "documents", "findings", "summary"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "contentHash"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "./finding.schema.json" }
    },
    "summary": {
      "type": "object",
      "required": ["documents", "findings", "errors", "warnings", "infos"],
      "properties": {
        "documents": { "type": "integer", "minimum": 0 },
        "findings": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "infos": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
