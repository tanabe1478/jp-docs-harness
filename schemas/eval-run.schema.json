{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tanabe1478/jp-docs-harness/schemas/eval-run.schema.json",
  "title": "jp-docs-harness evaluation run manifest",
  "type": "object",
  "required": ["schemaVersion", "promptVersion", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "promptVersion": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "packetFile", "candidateFile"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "packetFile": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*\\.packet\\.json$" },
          "candidateFile": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*\\.json$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
