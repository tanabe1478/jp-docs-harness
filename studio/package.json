{
  "name": "jp-docs-studio",
  "version": "0.1.0",
  "private": true,
  "description": "AIと対話しながら自分の考えを深めて書くための、ローカルの静かな執筆環境",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node src/server/main.ts --dev",
    "build": "vite build",
    "start": "node src/server/main.ts",
    "login": "node src/server/login.ts",
    "logout": "node src/server/login.ts --logout",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"tests/unit/**/*.spec.ts\"",
    "test:e2e": "vite build && playwright test",
    "test:ai-smoke": "node tests/smoke/openai-smoke.ts",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "openai": "7.25.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "@playwright/test": "1.63.0",
    "@tauri-apps/api": "2.12.2",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
