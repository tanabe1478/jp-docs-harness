{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jp-docs Studio",
  "version": "0.1.0",
  "identifier": "jp.tanabe1478.jp-docs-studio",
  "build": {
    "frontendDist": "splash",
    "beforeBuildCommand": "npm run build && node scripts/stage-desktop.mjs",
    "beforeDevCommand": "npm run build && node scripts/stage-desktop.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "AIと対話しながら考えを深めて書くための執筆環境",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/node"],
    "resources": {
      "runtime/app/": "app/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
