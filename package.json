{
  "name": "jp-docs-harness",
  "version": "0.9.0",
  "description": "AIが生成する日本語ドキュメントの品質を検査するハーネス",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanabe1478/jp-docs-harness.git"
  },
  "homepage": "https://github.com/tanabe1478/jp-docs-harness#readme",
  "bugs": {
    "url": "https://github.com/tanabe1478/jp-docs-harness/issues"
  },
  "keywords": [
    "pi-package",
    "textlint",
    "japanese",
    "ai-writing"
  ],
  "bin": {
    "jp-docs-harness": "./bin/jp-docs-harness.mjs"
  },
  "files": [
    ".claude-plugin/",
    ".textlintrc.json",
    "AGENTS.md",
    "bin/",
    "eval/",
    "extensions/",
    "hooks/",
    "lib/",
    "prompts/",
    "scripts/",
    "skills/",
    "schemas/"
  ],
  "scripts": {
    "lint": "node ./bin/jp-docs-harness.mjs",
    "lint:fix": "textlint --fix \"**/*.md\"",
    "test": "node --test",
    "eval:smoke": "node ./bin/jp-docs-harness.mjs eval eval/cases/grounding-basic/gold.json eval/cases/grounding-basic/gold.json",
    "eval:corpus": "node ./scripts/eval-corpus.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@textlint-ja/textlint-rule-preset-ai-writing": "1.7.0",
    "ajv": "8.18.0",
    "textlint": "15.8.0",
    "yaml": "2.8.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./extensions/textlint-on-settle.ts"
    ]
  },
  "engines": {
    "node": ">=20.18.0"
  }
}
